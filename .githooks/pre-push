#!/bin/sh
# Pre-push guards, mirroring what CI enforces on master:
# 1. nix fmt -- . --check (alejandra, fail-closed) - the "unformatted
#    push, public red CI" class (2026-09-16, two reds, ~13 min).
# 2. Check-inventory lockstep (scripts/check-inventory.sh) - the flake's
#    declared checks must match CI's expected lists; a drift commit
#    fails HERE instead of shipping unnoticed master reds (the
#    2026-09-23 class: three reds before anyone looked).
#
# Bypass with `git push --no-verify` (discouraged; CI still enforces).
# NOTE for fresh clones: `core.hooksPath` is repo-LOCAL config - run
# `git config core.hooksPath .githooks` after cloning or none of this
# runs (it dangles silently by design; CI is the real gate).

set -eu

echo "pre-push: nix fmt -- . --check"
nix fmt -- . --check

echo "pre-push: check-inventory lockstep"
bash scripts/check-inventory.sh

# 3. Workflow actionlint (CI parity): CI's actionlint runs WITH shellcheck
#    (preinstalled on runners); a shellcheck-less local machine shipped a
#    public red that way (2026-10-05). Fail-closed on findings, fail-open
#    on tool unavailability (CI is the hard gate).
echo "pre-push: workflow actionlint"
if command -v actionlint >/dev/null 2>&1 && command -v shellcheck >/dev/null 2>&1; then
  actionlint
elif command -v nix >/dev/null 2>&1; then
  nix shell nixpkgs#shellcheck nixpkgs#actionlint -c actionlint
else
  echo "pre-push: actionlint/shellcheck unavailable - skipping (CI enforces)" >&2
fi

# 4. Markdown lints (CI parity, fast + nix-free): pipes + list markers +
#    check-set drift alarm. The daemon pushes bypass this hook entirely -
#    CI is the hard gate; this front-runs it for human pushes.
echo "pre-push: markdown lints (pipes, list markers, drift alarm)"
bash scripts/check-md-table-pipes.sh
bash scripts/check-md-list-markers.sh
bash scripts/check-check-set-drift.sh

# 5. Statix (CI parity, the 4x-red W20 class): the PINNED statix, same
#    rev CI uses, so local findings match CI exactly.
echo "pre-push: pinned statix"
if command -v nix >/dev/null 2>&1; then
  rev="$(nix flake metadata --json . | jq -r '.locks.nodes.nixpkgs.locked.rev')"
  nix run "github:NixOS/nixpkgs/$rev#statix" -- check .
else
  echo "pre-push: nix unavailable - skipping statix (CI enforces)" >&2
fi
